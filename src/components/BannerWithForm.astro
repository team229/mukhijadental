---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { siteConfig } from "../data/site";
import { getAsset } from "../lib/images";
import { Phone } from "lucide-react";

interface Props {
  label?: string;
  title: string;
  description: string;
  image?: ImageMetadata;
}

const {
  label = "Welcome",
  title,
  description,
  image = getAsset("/images/clinic/exterior/clinic-front.webp"),
} = Astro.props;
---

<section class="py-8 md:py-12">
  <div class="max-w-7xl mx-auto px-4">
    <div class="rounded-[2.5rem] overflow-hidden shadow-2xl border border-slate-100 bg-white">
      <div class="grid grid-cols-1 lg:grid-cols-5">
        <div class="lg:col-span-3 relative min-h-[350px] lg:min-h-[480px] flex items-center">
          <Image src={image} alt={title} class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-r from-brand/95 via-brand/80 to-transparent"></div>
          <div class="relative p-8 md:p-12 flex flex-col justify-center h-full text-white max-w-xl">
            <div>
              <span class="px-3.5 py-1 bg-accent/25 text-accent-light border border-accent/40 rounded-full text-xs font-bold tracking-widest uppercase mb-4 inline-block shadow-inner">
                {label}
              </span>
            </div>
            <h1 class="font-display text-3xl md:text-5xl font-black mb-4 leading-tight tracking-tight text-white drop-shadow-sm">{title}</h1>
            <p class="text-white/90 text-sm sm:text-base leading-relaxed mb-6 font-sans">{description}</p>
            <a href={`tel:${siteConfig.phone}`} class="inline-flex items-center gap-2 font-bold text-accent-light hover:text-white transition-all duration-200 text-sm tracking-wider hover:scale-[1.02]">
              <Phone className="w-4 h-4 text-accent-light shrink-0" /> {siteConfig.phone}
            </a>
          </div>
        </div>
        <div class="lg:col-span-2 bg-gradient-to-br from-slate-50 to-white p-6 md:p-8 flex items-center border-t lg:border-t-0 lg:border-l border-slate-100">
          <div class="w-full">
            <slot />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
