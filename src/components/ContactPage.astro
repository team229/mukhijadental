---
import AppointmentForm from "./react/AppointmentForm";
import { siteConfig } from "../data/site";
import { Phone, MessageCircle, Mail, Clock, MapPin } from "lucide-react";

interface Props {
  html: string;
  faqs?: { question: string; answer: string }[];
}

const { html, faqs = [] } = Astro.props;

const mainPhone = siteConfig.phone.replace(/[^+\d]/g, "");
const altPhone = siteConfig.phoneAlt.replace(/[^+\d]/g, "");
const whatsappLink = `https://wa.me/${altPhone}`;
const mapEmbedUrl = "https://maps.google.com/maps?q=" + encodeURIComponent("Mukhija Dental & Implant Centre, Model Town, Sonipat, Haryana") + "&z=15&output=embed";

const locateAnchor = "<h2>Where to Find Us</h2>";
const restAnchor = "<h2>What to Expect When You Reach Out</h2>";

let introHtml = html;
let locateHtml = "";
let restHtml = "";
const locateIdx = html.indexOf(locateAnchor);
if (locateIdx !== -1) {
  introHtml = html.slice(0, locateIdx);
  const restIdx = html.indexOf(restAnchor, locateIdx);
  if (restIdx !== -1) {
    locateHtml = html.slice(locateIdx, restIdx);
    restHtml = html.slice(restIdx);
  } else {
    locateHtml = html.slice(locateIdx);
  }
} else {
  restHtml = html;
}

const contactCards = [
  {
    icon: Phone,
    title: "Call Us",
    value: siteConfig.phone,
    sub: `Alt: ${siteConfig.phoneAlt}`,
    href: `tel:${mainPhone}`,
  },
  {
    icon: MessageCircle,
    title: "WhatsApp",
    value: siteConfig.phoneAlt,
    sub: "Fastest way to reach us",
    href: whatsappLink,
    external: true,
  },
  {
    icon: Mail,
    title: "Email Us",
    value: siteConfig.email,
    sub: "For detailed queries",
    href: `mailto:${siteConfig.email}`,
  },
  {
    icon: Clock,
    title: "Clinic Hours",
    value: siteConfig.hours,
    sub: "Sundays by appointment",
  },
];
---

<section class="py-12 md:py-16">
  <div class="max-w-7xl mx-auto px-4">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
      <div class="lg:col-span-2">
        <h1 class="sr-only">Contact Us</h1>

        <div class="prose-content" set:html={introHtml} />

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-10">
          {contactCards.map((card) => (
            <a
              href={card.href}
              target={card.external ? "_blank" : undefined}
              rel={card.external ? "noopener noreferrer" : undefined}
              class="group flex items-start gap-4 bg-white rounded-2xl p-5 border border-slate-100 shadow-sm hover:shadow-md hover:border-accent/40 transition-all"
            >
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-brand to-brand-dark text-white shadow-sm">
                <card.icon class="w-5 h-5" />
              </span>
              <span class="min-w-0">
                <span class="block text-[11px] font-semibold text-muted uppercase tracking-wider">{card.title}</span>
                <span class="block font-semibold text-brand-dark group-hover:text-accent transition-colors break-words">{card.value}</span>
                <span class="block text-xs text-muted mt-0.5">{card.sub}</span>
              </span>
            </a>
          ))}
        </div>

        {locateHtml && <div class="prose-content mt-10" set:html={locateHtml} />}

        <div class="mt-10">
          <div class="flex items-start gap-3 mb-5">
            <MapPin class="w-5 h-5 text-accent shrink-0 mt-0.5" />
            <p class="text-slate-600 leading-relaxed">{siteConfig.address} — Clinic is fully wheelchair-accessible, including parking.</p>
          </div>
          <div class="rounded-2xl overflow-hidden border border-slate-200 shadow-sm aspect-[4/3] sm:aspect-[16/9] bg-surface">
            <iframe
              title="Mukhija Dental & Implant Centre location"
              src={mapEmbedUrl}
              class="w-full h-full"
              style="border:0"
              loading="lazy"
              allowfullscreen
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </div>
        </div>

        {restHtml && <div class="prose-content mt-10" set:html={restHtml} />}

        {faqs.length > 0 && (
          <div class="mt-12">
            <h2 class="font-display text-2xl font-bold text-brand mb-6">Frequently Asked Questions</h2>
            <div class="space-y-4">
              {faqs.map((faq) => (
                <details class="group bg-surface rounded-xl p-5 border border-slate-100">
                  <summary class="font-semibold text-brand-dark cursor-pointer list-none flex items-center justify-between">
                    {faq.question}
                    <span class="text-accent group-open:rotate-180 transition-transform">▾</span>
                  </summary>
                  <p class="mt-3 text-slate-600 leading-relaxed">{faq.answer}</p>
                </details>
              ))}
            </div>
          </div>
        )}
      </div>

      <div class="lg:col-span-1">
        <div class="sticky top-24">
          <AppointmentForm client:visible />
        </div>
      </div>
    </div>
  </div>
</section>
