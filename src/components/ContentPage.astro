---
import AppointmentForm from "./react/AppointmentForm";

interface Props {
  html: string;
  faqs?: { question: string; answer: string }[];
  showForm?: boolean;
}

const { html, faqs = [], showForm = true } = Astro.props;
---

<section class="py-12 md:py-16">
  <div class="max-w-7xl mx-auto px-4">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
      <div class="lg:col-span-2">
        <div class="prose-content" set:html={html} />

        {faqs.length > 0 && (
          <div class="mt-12">
            <h2 class="font-display text-2xl font-bold text-brand mb-6">Frequently Asked Questions</h2>
            <div class="space-y-4">
              {faqs.map((faq) => (
                <details class="group bg-surface rounded-xl p-5 border border-slate-100">
                  <summary class="font-semibold text-brand-dark cursor-pointer list-none flex items-center justify-between">
                    {faq.question}
                    <span class="text-accent group-open:rotate-180 transition-transform">▾</span>
                  </summary>
                  <p class="mt-3 text-slate-600 leading-relaxed">{faq.answer}</p>
                </details>
              ))}
            </div>
          </div>
        )}
      </div>

      {showForm && (
        <div class="lg:col-span-1">
          <div class="sticky top-24">
            <AppointmentForm client:visible />
          </div>
        </div>
      )}
    </div>
  </div>
</section>
