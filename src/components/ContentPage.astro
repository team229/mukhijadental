---
import AppointmentForm from "./react/AppointmentForm";
import FaqAccordion, { type FaqItem } from "./FaqAccordion.astro";

interface Props {
  html: string;
  faqs?: FaqItem[];
  showForm?: boolean;
}

const { html, faqs = [], showForm = true } = Astro.props;
---

<section class="py-12 md:py-16">
  <div class="max-w-7xl mx-auto px-4">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
      <div class="lg:col-span-2">
        <div class="prose-content" set:html={html} />
      </div>

      {showForm && (
        <div class="lg:col-span-1">
          <div class="sticky top-24">
            <AppointmentForm client:visible />
          </div>
        </div>
      )}
    </div>
  </div>
</section>

{faqs.length > 0 && (
  <FaqAccordion faqs={faqs} openFirst={true} />
)}
