---
import { doctors } from "../data/homepage";
interface Props {
  label?: string;
  title?: string;
  description?: string;
}
const { label = "Our Specialists", title = "Meet Our Doctors", description = "Experienced specialists dedicated to gentle, precise, patient-first dental care." } = Astro.props;
---

<section class="py-16 md:py-24 bg-white">
  <div class="max-w-7xl mx-auto px-4">
    <div class="text-center mb-12">
      <span class="text-accent text-xs font-bold uppercase tracking-[0.2em]">{label}</span>
      <h2 class="font-display text-3xl md:text-4xl font-extrabold text-brand-dark mt-2 mb-3">{title}</h2>
      <p class="text-slate-600 max-w-2xl mx-auto">{description}</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
      {doctors.map((doctor) => (
        <div class="group bg-white rounded-2xl overflow-hidden border border-slate-200 shadow-sm hover:shadow-xl transition-all duration-300">
          <div class="relative aspect-[4/5] overflow-hidden">
            <img src={doctor.image} alt={doctor.name} class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-brand-dark/40 to-transparent"></div>
            <span class="absolute bottom-4 left-4 inline-flex px-3 py-1 bg-white/90 backdrop-blur text-accent text-[11px] font-bold uppercase tracking-wider rounded-full">
              {doctor.credentials}
            </span>
          </div>
          <div class="p-7">
            <h3 class="font-display text-2xl font-bold text-brand tracking-tight">{doctor.name}</h3>
            <p class="text-accent text-sm font-medium mt-1 mb-3">{doctor.specialty}</p>
            <p class="text-sm text-slate-600 leading-relaxed">{doctor.bio}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
