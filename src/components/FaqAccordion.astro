---
import SectionHeading from "./SectionHeading.astro";

export interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  faqs: FaqItem[];
  /** Render the single "Frequently Asked Questions" heading above the list. */
  showHeading?: boolean;
  /** Open the first accordion item by default. */
  openFirst?: boolean;
}

const { faqs, showHeading = true, openFirst = false } = Astro.props;

const items = Array.isArray(faqs) ? faqs.filter((f) => f?.question && f?.answer) : [];
---

{
  items.length > 0 && (
    <section class="py-16 md:py-24 bg-white">
      <div class="max-w-3xl mx-auto px-4">
        {showHeading && <SectionHeading label="FAQ" title="Frequently Asked Questions" />}
        <div class="space-y-4">
          {items.map((faq, i) => (
            <details
              class="group bg-surface rounded-2xl border border-slate-200 overflow-hidden transition-all duration-300"
              open={openFirst && i === 0}
            >
              <summary class="flex items-center justify-between gap-4 p-5 font-semibold text-brand-dark cursor-pointer list-none">
                <span class="flex items-center gap-3 text-left">
                  <span class="font-display font-bold text-accent text-sm">{String(i + 1).padStart(2, "0")}</span>
                  {faq.question}
                </span>
                <span
                  class="shrink-0 w-8 h-8 rounded-full bg-accent/10 text-accent flex items-center justify-center transition-transform duration-200 group-open:rotate-180"
                  aria-hidden="true"
                >
                  ▾
                </span>
              </summary>
              <p class="px-5 pb-5 text-slate-600 leading-relaxed">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )
}
