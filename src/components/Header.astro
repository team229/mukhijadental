---
import { siteConfig, navigation } from "../data/site";
import MobileNav from "./react/MobileNav";
import { Phone, Mail, ChevronDown } from "lucide-react";
---

<!-- Brand masthead (desktop only, scrolls away) -->
<div class="hidden xl:block bg-gradient-to-br from-brand-dark via-brand to-brand text-white relative overflow-hidden">
  <div class="pointer-events-none absolute inset-0 opacity-[0.08]">
    <div class="absolute -top-12 -left-12 w-72 h-72 rounded-full bg-white"></div>
    <div class="absolute -bottom-20 -right-12 w-80 h-80 rounded-full bg-accent-light"></div>
  </div>

  <div class="relative mx-auto max-w-7xl px-4 py-7 md:py-9 flex flex-wrap items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-3" aria-label="Mukhija Dental & Implant Centre home">
      <img src="/logo-white.png" alt={siteConfig.name} class="h-11 w-11 md:h-12 md:w-12 rounded-xl object-contain" />
      <div>
        <p class="font-display font-extrabold text-xl md:text-2xl leading-tight tracking-tight">Dr. Mukhija's</p>
        <p class="text-[10px] md:text-[11px] font-medium text-white/70 tracking-[0.2em] uppercase">Dental &amp; Implant Centre</p>
      </div>
    </a>

    <div class="hidden md:flex items-center gap-6">
      <a href={`tel:${siteConfig.phone}`} class="hover:text-accent-light transition-colors inline-flex items-center gap-2 text-sm font-medium">
        <Phone className="w-4 h-4 text-accent-light" /> {siteConfig.phone}
      </a>
      <a href={`mailto:${siteConfig.email}`} class="hover:text-accent-light transition-colors inline-flex items-center gap-2 text-sm font-medium">
        <Mail className="w-4 h-4 text-accent-light" /> {siteConfig.email}
      </a>
      <a
        href="/contact-us/"
        class="inline-flex items-center px-5 py-2.5 bg-white hover:bg-surface text-brand font-bold text-xs uppercase tracking-wider rounded-xl shadow-md hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300"
      >
        Book Appointment
      </a>
    </div>
  </div>
</div>

<!-- Sticky navigation bar -->
<div class="sticky top-0 z-50 bg-white/95 backdrop-blur border-b border-slate-200/70 shadow-sm">
  <div class="mx-auto max-w-7xl px-4">
    <div class="flex items-center justify-between h-16">
      <!-- Logo (mobile / tablet only; the desktop rail is menu-only) -->
      <div class="flex-1 flex items-center">
        <a href="/" class="xl:hidden flex items-center gap-2.5" aria-label="Mukhija Dental & Implant Centre">
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-brand-dark via-brand to-brand">
            <img src="/logo-white.png" alt={siteConfig.name} class="h-8 w-8 object-contain" />
          </span>
          <span class="font-display font-bold text-brand text-base tracking-tight">Dr. Mukhija's</span>
        </a>
      </div>

      <nav class="hidden xl:flex items-center gap-2" aria-label="Main navigation">
        {navigation.map((item) =>
          item.children ? (
            <div class="relative group" key={item.label}>
              <a
                href={item.href === "#" ? item.children[0].href : item.href}
                class="group/link relative inline-flex items-center gap-1 px-4 py-2 text-sm font-medium whitespace-nowrap text-slate-600 hover:text-accent transition-colors"
              >
                {item.label}
                <ChevronDown className="w-3.5 h-3.5 transition-transform duration-200 group-hover:rotate-180" />
                <span class="pointer-events-none absolute inset-x-4 bottom-0.5 h-0.5 rounded-full bg-accent origin-center scale-x-0 group-hover/link:scale-x-100 transition-transform duration-300"></span>
              </a>
              <div class="absolute left-0 top-full pt-3 opacity-0 invisible translate-y-1 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 transition-all duration-200">
                <div class="bg-white rounded-2xl shadow-xl border border-slate-200 p-2 min-w-[230px]">
                  {item.children.map((child) => (
                    <a
                      href={child.href}
                      class="block px-4 py-2.5 text-sm text-slate-600 hover:bg-surface hover:text-accent rounded-xl transition-colors whitespace-nowrap"
                    >
                      {child.label}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ) : (
            <a
              href={item.href}
              class="group/link relative inline-flex items-center px-4 py-2 text-sm font-medium whitespace-nowrap text-slate-600 hover:text-accent transition-colors"
            >
              {item.label}
              <span class="pointer-events-none absolute inset-x-4 bottom-0.5 h-0.5 rounded-full bg-accent origin-center scale-x-0 group-hover/link:scale-x-100 transition-transform duration-300"></span>
            </a>
          )
        )}
      </nav>

      <div class="flex-1 flex items-center justify-end">
        <MobileNav client:load />
      </div>
    </div>
  </div>
</div>
