---
import type { RelatedLink } from "../data/internalLinks";

interface Props {
  heading: string;
  links: RelatedLink[];
  /** Optional intro line under the heading. */
  description?: string;
}

const { heading, links, description } = Astro.props;
const items = Array.isArray(links) ? links.filter((l) => l?.href && l?.label) : [];
---

{
  items.length > 0 && (
    <div class="mt-12 not-prose">
      <h2 class="font-display text-2xl md:text-3xl font-bold text-brand-dark mb-2">{heading}</h2>
      {description && <p class="text-slate-500 mb-6 max-w-2xl">{description}</p>}
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {items.map((link) => (
          <li>
            <a
              href={link.href}
              class="group flex h-full flex-col rounded-xl border border-slate-200 bg-surface p-5 transition-all hover:border-accent/40 hover:bg-white hover:shadow-md"
            >
              <span class="font-semibold text-brand-dark group-hover:text-accent transition-colors">
                {link.label}
              </span>
              {link.note && <span class="mt-2 text-sm text-slate-600 leading-relaxed">{link.note}</span>}
            </a>
          </li>
        ))}
      </ul>
    </div>
  )
}
