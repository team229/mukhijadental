---
import SectionHeading from "./SectionHeading.astro";

interface Props {
  label?: string;
  title: string;
  description?: string;
  image: string;
  imageAlt?: string;
  reverse?: boolean;
  bg?: "white" | "surface";
  centerHeading?: boolean;
}

const { label, title, description, image, imageAlt = title, reverse = false, bg = "white", centerHeading = true } = Astro.props;
---

<section class:list={["py-14 md:py-20", bg === "surface" ? "bg-surface" : "bg-white"]}>
  <div class="max-w-7xl mx-auto px-4">
    {centerHeading && (
      <SectionHeading label={label} title={title} description={description} centered={true} />
    )}
    <div class:list={["grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center", reverse && "lg:[direction:rtl] lg:*:[direction:ltr]"]}>
      <div class="space-y-6">
        {!centerHeading && (
          <div>
            {label && <p class="text-accent font-semibold uppercase tracking-wide text-sm mb-3">{label}</p>}
            <h2 class="font-display text-3xl md:text-4xl font-bold text-brand mb-5">{title}</h2>
            {description && <p class="text-slate-600 leading-relaxed mb-6">{description}</p>}
          </div>
        )}
        <slot />
      </div>
      <div class="relative group w-full">
        <div class="absolute -inset-3 rounded-[2.2rem] bg-gradient-to-tr from-accent/20 to-brand/10 -z-10 group-hover:scale-[1.03] transition-all duration-300"></div>
        <div class="rounded-[2rem] overflow-hidden shadow-2xl aspect-[4/3] w-full border border-slate-100/50 bg-white">
          <img src={image} alt={imageAlt} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
        </div>
      </div>
    </div>
  </div>
</section>
