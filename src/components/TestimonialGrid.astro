---
import { testimonials } from "../data/site";
import SectionHeading from "./SectionHeading.astro";
---

<section class="py-14 md:py-20 bg-surface">
  <div class="max-w-7xl mx-auto px-4">
    <SectionHeading
      label="Patient Reviews"
      title="What Our Patients Say"
      description="Real feedback from patients across Sonipat, Murthal, Kundli and the surrounding sectors."
    />

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {testimonials.map((t) => (
        <div class="bg-white rounded-2xl shadow-md border border-slate-100 p-6 flex flex-col hover:shadow-lg transition-shadow duration-300">
          <div class="flex gap-0.5 text-yellow-400 mb-4">
            {Array.from({ length: t.rating }).map((_, i) => (
              <span key={i} class="text-xl">★</span>
            ))}
          </div>
          <p class="text-slate-600 leading-relaxed italic mb-6 flex-1">"{t.text}"</p>
          <div class="flex items-center justify-between gap-4 border-t border-slate-100 pt-4">
            <div>
              <p class="font-semibold text-brand-dark">{t.name}</p>
              <p class="text-sm text-slate-500">{t.location}</p>
            </div>
            <span class="inline-flex items-center gap-1 text-xs text-slate-400">
              <span class="w-4 h-4 rounded-full bg-brand text-white flex items-center justify-center text-[9px] font-bold">G</span>
              Google
            </span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
