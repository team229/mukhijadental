---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import ContentPage from "../components/ContentPage.astro";
import ContactPage from "../components/ContactPage.astro";
import DoctorsSection from "../components/DoctorsSection.astro";
import RelatedContent from "../components/RelatedContent.astro";
import { staticPages } from "../data/pages";
import { blogPosts } from "../data/blogs";
import { getPageContent, contentToHtml } from "../utils/content";

export function getStaticPaths() {
  const pageKeys = [
    "team-of-specialists",
    "cases",
    "virtual-smile-makeover",
    "smile-analysis",
    "articles",
    "contact-us",
  ] as const;

  return pageKeys.map((key) => ({
    params: { page: key },
    props: { pageKey: key },
  }));
}

const { pageKey } = Astro.props;
const page = staticPages[pageKey as keyof typeof staticPages];
const lines = getPageContent(page.contentKey);
const { html, faqs } = contentToHtml(lines);
---

<BaseLayout title={page.title} description={page.description} faqs={faqs}>
  {pageKey === "contact-us" ? (
    <ContactPage html={html} faqs={faqs} />
  ) : pageKey === "team-of-specialists" ? (
    <>
      <PageHero title={page.heading} subtitle={page.description} />
      <DoctorsSection
        label="Our Specialists"
        title="Meet Our Doctors"
        description="Experienced specialists dedicated to gentle, precise, patient-first dental care."
      />
      <ContentPage html={html} faqs={faqs} showForm={false} />
    </>
  ) : (
    <>
      <PageHero title={page.heading} subtitle={page.description} />
      <ContentPage html={html} faqs={faqs} showForm={false} />

      {pageKey === "articles" && (
        <section class="py-12 md:py-16 bg-white">
          <div class="max-w-7xl mx-auto px-4">
            <RelatedContent
              heading="All dental health articles"
              description="Every guide we've published, newest first. Each one is written to answer the questions patients actually ask at the chair."
              links={blogPosts.map((post) => ({
                href: `/blog/${post.slug}/`,
                label: post.title,
              }))}
            />
            <p class="mt-6 text-slate-500">
              Prefer the blog index? It carries the same articles with cover images and dates:{" "}
              <a href="/blog/" class="text-accent font-medium underline">browse all dental health blogs</a>.
            </p>
          </div>
        </section>
      )}
    </>
  )}
</BaseLayout>
