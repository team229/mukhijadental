---
import { Image, getImage } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import BannerWithForm from "../../components/BannerWithForm.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import SplitSection from "../../components/SplitSection.astro";
import GoogleMap from "../../components/GoogleMap.astro";
import ContentPage from "../../components/ContentPage.astro";
import AppointmentForm from "../../components/react/AppointmentForm";
import TestimonialCarousel from "../../components/react/TestimonialCarousel";
import CaseImageSlider from "../../components/react/CaseImageSlider";
import { locations } from "../../data/pages";
import { getPageContent, contentToHtml } from "../../utils/content";
import { whyChooseUsPoints, technologyItems } from "../../data/homepage";
import { caseImages } from "../../data/serviceDetails";
import { faqs } from "../../data/site";
import { getAsset } from "../../lib/images";

export function getStaticPaths() {
  return locations.map((location) => ({
    params: { slug: location.slug },
    props: { location },
  }));
}

const { location } = Astro.props;
const lines = getPageContent(location.contentKey);
const { html, faqs: contentFaqs } = contentToHtml(lines);
const pageFaqs = contentFaqs.length > 0 ? contentFaqs : faqs;

const caseImagesOptimized = await Promise.all(
  caseImages.map(async (img) => ({
    ...img,
    src: (await getImage({ src: getAsset(img.src) })).src,
  }))
);
---

<BaseLayout title={location.title} description={location.description} faqs={pageFaqs}>
  <!-- Section 1: Banner with form -->
  <BannerWithForm
    label="Locations"
    title={location.heading}
    description={location.description}
    image={getAsset("/images/clinic/exterior/clinic-front.webp")}
  >
    <AppointmentForm client:visible compact={true} />
  </BannerWithForm>

  <!-- Section 2: Why Choose Us -->
  <SplitSection
    label="Why Choose Us"
    title="Why Choose Mukhija Dental Clinic"
    description="Trusted dental care in Model Town, Sonipat — serving patients from across the region with comprehensive, patient-first treatment."
    image={getAsset("/images/clinic/reception/reception-1.jpeg")}
    bg="surface"
  >
    <ul class="space-y-4">
      {whyChooseUsPoints.map((point) => (
        <li class="flex gap-3">
          <span class="shrink-0 w-8 h-8 bg-accent/10 text-accent rounded-full flex items-center justify-center font-bold text-sm">✓</span>
          <div>
            <p class="font-semibold text-brand-dark">{point.title}</p>
            <p class="text-sm text-slate-600">{point.description}</p>
          </div>
        </li>
      ))}
    </ul>
  </SplitSection>

  <!-- Section 3: Google Reviews -->
  <section class="py-14 md:py-20">
    <div class="max-w-7xl mx-auto px-4">
      <SectionHeading label="Reviews" title="Our Google Reviews" description="See why families across Sonipat trust Mukhija Dental & Implant Centre." />
      <div class="max-w-2xl mx-auto">
        <TestimonialCarousel client:visible />
      </div>
    </div>
  </section>

  <!-- Section 4: Case Images -->
  <section class="py-14 md:py-20 bg-surface">
    <div class="max-w-7xl mx-auto px-4">
      <SectionHeading label="Results" title="Patient Cases" description="Real smile transformations from our clinic." />
      <CaseImageSlider client:visible images={caseImagesOptimized} />
    </div>
  </section>

  <!-- Section 5: Latest Technology -->
  <section class="py-14 md:py-20">
    <div class="max-w-7xl mx-auto px-4">
      <SectionHeading label="Innovation" title="Latest Technologies With Us" description="Advanced instruments for precise, comfortable dental care." />
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {technologyItems.slice(0, 3).map((tech) => (
          <div class="bg-white rounded-3xl overflow-hidden shadow-md border border-slate-100">
            <div class="aspect-[16/10] overflow-hidden">
              <Image src={getAsset(tech.image)} alt={tech.title} class="w-full h-full object-cover" loading="lazy" />
            </div>
            <div class="p-5">
              <h3 class="font-semibold text-brand-dark mb-2">{tech.title}</h3>
              <p class="text-sm text-slate-600">{tech.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 6: FAQs -->
  <section class="py-14 md:py-20 bg-surface">
    <div class="max-w-3xl mx-auto px-4">
      <SectionHeading label="FAQ" title="Frequently Asked Questions" />
      <div class="space-y-4">
        {pageFaqs.map((faq) => (
          <details class="group bg-white rounded-2xl p-5 border border-slate-100">
            <summary class="font-semibold text-brand-dark cursor-pointer list-none flex items-center justify-between">
              {faq.question}
              <span class="text-accent group-open:rotate-180 transition-transform">▾</span>
            </summary>
            <p class="mt-3 text-slate-600 leading-relaxed">{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 7: Google Maps -->
  <GoogleMap />

  <!-- SEO Content -->
  <ContentPage html={html} faqs={[]} showForm={false} />
</BaseLayout>
