---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import ContentPage from "../components/ContentPage.astro";
import { staticPages } from "../data/pages";
import { getPageContent, contentToHtml } from "../utils/content";
import { technologyItems } from "../data/homepage";

const page = staticPages.technology;
const lines = getPageContent(page.contentKey);
const { html, faqs } = contentToHtml(lines);
---

<BaseLayout title={page.title} description={page.description}>
  <PageHero title={page.heading} subtitle={page.description} />

  <section class="py-14 md:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {technologyItems.map((tech) => (
          <div class="group bg-surface rounded-2xl overflow-hidden border border-slate-200 shadow-sm hover:shadow-lg transition-all duration-300">
            <div class="aspect-[16/10] overflow-hidden">
              <img src={tech.image} alt={tech.alt ?? tech.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
            </div>
            <div class="p-6">
              <h3 class="font-display font-bold text-brand-dark mb-2 leading-snug">{tech.title}</h3>
              <p class="text-sm text-slate-600 leading-relaxed">{tech.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <ContentPage html={html} faqs={faqs} />
</BaseLayout>
