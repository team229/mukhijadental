---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import ContentPage from "../components/ContentPage.astro";
import { staticPages } from "../data/pages";
import { getPageContent, contentToHtml } from "../utils/content";
import { getImagesByCategory } from "../data/images";

const page = staticPages.technology;
const lines = getPageContent(page.contentKey);
const { html, faqs } = contentToHtml(lines);
const treatmentImages = getImagesByCategory("treatment");
---

<BaseLayout title={page.title} description={page.description}>
  <PageHero title={page.heading} subtitle={page.description} />

  <section class="py-12 bg-surface">
    <div class="max-w-7xl mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {treatmentImages.map((img) => (
          <div class="rounded-2xl overflow-hidden shadow-lg">
            <img src={img.src} alt={img.alt} class="w-full aspect-[16/10] object-cover" loading="lazy" />
            <div class="p-4 bg-white">
              <p class="font-medium text-brand-dark">{img.alt}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <ContentPage html={html} faqs={faqs} />
</BaseLayout>
