---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../data/site";
import { Check, Phone } from "lucide-react";
---

<BaseLayout
  title="Thank You | Mukhija Dental Clinic"
  description="Thank you for choosing Mukhija Dental & Implant Centre. Your appointment request has been received — our team will contact you shortly to confirm."
  noindex={true}
>
  <section class="relative bg-gradient-to-br from-brand-dark via-brand to-brand text-white overflow-hidden">
    <div class="pointer-events-none absolute inset-0 opacity-[0.08]">
      <div class="absolute -top-12 -left-12 w-72 h-72 rounded-full bg-white"></div>
      <div class="absolute -bottom-20 -right-12 w-80 h-80 rounded-full bg-accent-light"></div>
    </div>

    <div class="relative max-w-3xl mx-auto px-4 py-20 md:py-28 text-center">
      <span class="inline-flex w-20 h-20 rounded-full bg-white/15 border border-white/25 items-center justify-center mb-7">
        <Check className="w-10 h-10 stroke-[2.5]" />
      </span>
      <h1 class="font-display text-4xl md:text-5xl font-extrabold mb-5 tracking-tight">Thank You!</h1>
      <p class="text-white/85 text-base sm:text-lg leading-relaxed max-w-xl mx-auto mb-9">
        Your appointment request has been received successfully. Our team will contact you shortly to confirm your booking.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-4">
        <a href="/" class="inline-flex items-center px-7 py-3.5 bg-white hover:bg-surface text-brand font-semibold rounded-xl transition-all duration-300 shadow-md">
          Return to Home
        </a>
        <a href={`tel:${siteConfig.phone}`} class="inline-flex items-center gap-2 px-7 py-3.5 bg-accent hover:bg-accent-light text-white font-bold rounded-xl transition-all duration-300 shadow-md">
          <Phone className="w-4 h-4" /> {siteConfig.phone}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
